{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A very awesome addon for a very awesome Hypixel SkyBlock mod.",
  "authors": [
    "Starred"
  ],
  "license": "BSD 3-Clause",
  "icon": "assets/nebulune/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "foo.starred.nebulune.Nebulune",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "nebulune.mixins.json"
  ],
  "accessWidener": "${accessWidener}",
  "depends": {
    "fabricloader": ">=0.17",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "${minecraft}",
    "athen": ">=0.1.8"
  },
  "custom": {
    "modmenu": {
      "update_checker": false,
      "parent": "athen"
    }
  }
}